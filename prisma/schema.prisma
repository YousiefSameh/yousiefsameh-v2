generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum BlogPostCategory {
  TECH              @map("tech")
  PERSONAL_GROWTH   @map("personal-growth")
  ENGINEERING_NOTES @map("engineering-notes")
  TUTORIALS         @map("tutorials")
  DEV_JOURNEY       @map("dev-journey")
}

enum ContactSubmissionStatus {
  NEW      @map("new")
  READ     @map("read")
  REPLIED  @map("replied")
  ARCHIVED @map("archived")
}

enum ResourceType {
  FILE @map("file")
  LINK @map("link")
}

enum ProjectCategory {
  WEB_APP      @map("web-app")
  SAAS         @map("saas")
  MOBILE       @map("mobile")
  LANDING_PAGE @map("landing-page")
  E_COMMERCE   @map("e-commerce")
  OTHER        @map("other")
}

enum ProjectStatus {
  COMPLETED         @map("completed")
  IN_PROGRESS       @map("in-progress")
  UNDER_DEVELOPMENT @map("under-development")
}

enum ProjectType {
  PORTFOLIO @map("portfolio")
  CLIENT    @map("client")
}

enum PreferredContact {
  WHATSAPP @map("whatsapp")
  EMAIL    @map("email")
  PHONE    @map("phone")
}

enum InvoiceStatus {
  UNPAID    @map("unpaid")
  PAID      @map("paid")
  PENDING   @map("pending")
  CANCELLED @map("cancelled")
}

enum SkillCategory {
  FRONTEND           @map("frontend")
  BACKEND            @map("backend")
  DATABASE           @map("database")
  DEVOPS             @map("devops")
  TOOLS              @map("tools")
  CURRENTLY_LEARNING @map("currently-learning")
}

enum TaskStatus {
  BACKLOG     @map("backlog")
  TODO        @map("todo")
  IN_PROGRESS @map("in-progress")
  REVIEW      @map("review")
  DONE        @map("done")
}

enum TaskPriority {
  LOW    @map("low")
  MEDIUM @map("medium")
  HIGH   @map("high")
  URGENT @map("urgent")
}

enum TaskType {
  FEATURE  @map("feature")
  BUG      @map("bug")
  CHORE    @map("chore")
  REFACTOR @map("refactor")
  MEETING  @map("meeting")
  OTHER    @map("other")
}

enum ReportStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
}

enum ActivityActorType {
  ADMIN  @map("admin")
  CLIENT @map("client")
}

enum ActivityEntityType {
  TASK       @map("task")
  COMMENT    @map("comment")
  ATTACHMENT @map("attachment")
  REPORT     @map("report")
}

enum ActivityAction {
  TASK_CREATED            @map("task_created")
  TASK_UPDATED            @map("task_updated")
  TASK_STATUS_CHANGED     @map("task_status_changed")
  TASK_PRIORITY_CHANGED   @map("task_priority_changed")
  TASK_TYPE_CHANGED       @map("task_type_changed")
  TASK_ASSIGNEE_CHANGED   @map("task_assignee_changed")
  TASK_DUE_DATE_CHANGED   @map("task_due_date_changed")
  TASK_LABELS_CHANGED     @map("task_labels_changed")
  TASK_VISIBILITY_CHANGED @map("task_visibility_changed")
  TASK_MOVED              @map("task_moved")
  TASK_DELETED            @map("task_deleted")

  COMMENT_ADDED   @map("comment_added")
  COMMENT_UPDATED @map("comment_updated")
  COMMENT_DELETED @map("comment_deleted")

  FILE_UPLOADED @map("file_uploaded")
  FILE_DELETED  @map("file_deleted")

  REPORT_CREATED   @map("report_created")
  REPORT_UPDATED   @map("report_updated")
  REPORT_PUBLISHED @map("report_published")
  REPORT_DELETED   @map("report_deleted")
}

// -----------------------------------------------------------------------------
// Models
// -----------------------------------------------------------------------------
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model BlogPost {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title              String
  slug               String           @unique
  excerpt            String
  content            Json
  featuredImageUrl   String?          @map("featured_image_url")
  category           BlogPostCategory
  tags               String[]         @default([])
  readingTimeMinutes Int?             @default(5) @map("reading_time_minutes")
  isPublished        Boolean?         @default(false) @map("is_published")
  publishedAt        DateTime?        @map("published_at") @db.Timestamptz
  createdAt          DateTime?        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime?        @default(now()) @map("updated_at") @db.Timestamptz

  @@map("blog_posts")
}

model Client {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  email     String?
  company   String?
  avatarUrl String? @map("avatar_url")

  notes            String?
  tags             String[]          @default([])
  preferredContact PreferredContact? @map("preferred_contact")

  accessToken     String?   @map("access_token")
  accessExpiresAt DateTime? @map("access_expires_at") @db.Timestamptz

  lastActiveAt DateTime? @map("last_active_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  projects Project[]

  @@map("clients")
}

model ContactSubmission {
  id          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  email       String
  projectType String?                  @map("project_type")
  budgetRange String?                  @map("budget_range")
  deadline    String?
  message     String
  status      ContactSubmissionStatus? @default(NEW)
  createdAt   DateTime?                @default(now()) @map("created_at") @db.Timestamptz

  @@map("contact_submissions")
}

model ProjectFile {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId    String        @map("project_id") @db.Uuid
  name         String
  url          String
  resourceType ResourceType? @default(FILE) @map("resource_type")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id])

  @@map("project_files")
}

model Project {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String
  slug             String          @unique
  shortDescription String          @map("short_description")
  fullDescription  Json?           @map("full_description")
  thumbnailUrl     String?         @map("thumbnail_url")
  featuredImageUrl String?         @map("featured_image_url")
  category         ProjectCategory
  techStack        String[]        @default([]) @map("tech_stack")
  status           ProjectStatus   @default(COMPLETED)
  liveUrl          String?         @map("live_url")
  repoUrl          String?         @map("repo_url")
  isFeatured       Boolean?        @default(false) @map("is_featured")
  displayOrder     Int?            @default(0) @map("display_order")
  year             Int?
  createdAt        DateTime?       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime?       @default(now()) @map("updated_at") @db.Timestamptz
  galleryImages    String[]        @default([]) @map("gallery_images")
  clientId         String?         @map("client_id") @db.Uuid
  type             ProjectType?    @default(PORTFOLIO)

  client        Client?        @relation(fields: [clientId], references: [id])
  files         ProjectFile[]
  tasks         Task[]
  testimonials  Testimonial[]
  weeklyReports WeeklyReport[]
  activityLogs  ActivityLog[]
  taskLabels    TaskLabel[]

  @@map("projects")
}

model Service {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String
  slug             String    @unique
  shortDescription String    @map("short_description")
  fullDescription  String?   @map("full_description")
  iconName         String?   @map("icon_name")
  displayOrder     Int?      @default(0) @map("display_order")
  isActive         Boolean?  @default(true) @map("is_active")
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime? @default(now()) @map("updated_at") @db.Timestamptz

  @@map("services")
}

model SiteSetting {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String    @unique
  value     String?
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamptz

  @@map("site_settings")
}

model Skill {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  category         SkillCategory
  iconName         String?       @map("icon_name")
  proficiencyLevel Int?          @default(80) @map("proficiency_level") // DB checked: >= 0 AND <= 100
  displayOrder     Int?          @default(0) @map("display_order")
  isVisible        Boolean?      @default(true) @map("is_visible")
  createdAt        DateTime?     @default(now()) @map("created_at") @db.Timestamptz

  @@map("skills")
}

model Task {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId       String        @map("project_id") @db.Uuid
  title           String
  description     String?
  descriptionRich Json?         @map("description_rich")
  status          TaskStatus?   @default(TODO)
  priority        TaskPriority? @default(MEDIUM)
  dueDate         DateTime?     @map("due_date") @db.Timestamptz
  assigneeId      String?       @map("assignee_id") @db.Uuid // Mentions auth.users(id) - omit relation for Supabase auth
  displayOrder    Int?          @default(0) @map("display_order")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @default(now()) @map("updated_at") @db.Timestamptz
  type            TaskType?     @default(FEATURE)
  isClientVisible Boolean?      @default(false) @map("is_client_visible")

  project     Project               @relation(fields: [projectId], references: [id])
  labels      TaskLabelAssignment[]
  comments    TaskComment[]
  attachments TaskAttachment[]
  subtasks    TaskSubtask[]         @relation("TaskParentToSubtask")
  parentLinks TaskSubtask[]         @relation("TaskChildToSubtask")

  @@index([projectId, status, displayOrder])
  @@index([projectId, createdAt])
  @@map("tasks")
}

model TaskLabel {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  name      String
  color     String? // e.g. hex or token
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  project Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   TaskLabelAssignment[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("task_labels")
}

model TaskLabelAssignment {
  taskId  String @map("task_id") @db.Uuid
  labelId String @map("label_id") @db.Uuid

  task  Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label TaskLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
  @@map("task_label_assignments")
}

model TaskComment {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId         String            @map("task_id") @db.Uuid
  parentId       String?           @map("parent_id") @db.Uuid
  authorType     ActivityActorType @map("author_type")
  authorUserId   String?           @map("author_user_id")
  authorClientId String?           @map("author_client_id") @db.Uuid
  body           Json
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz

  task    Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  parent  TaskComment?  @relation("TaskCommentToReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies TaskComment[] @relation("TaskCommentToReplies")

  @@index([taskId, createdAt])
  @@index([parentId])
  @@map("task_comments")
}

model TaskAttachment {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId             String            @map("task_id") @db.Uuid
  uploadedByType     ActivityActorType @map("uploaded_by_type")
  uploadedByUserId   String?           @map("uploaded_by_user_id")
  uploadedByClientId String?           @map("uploaded_by_client_id") @db.Uuid
  filePath           String            @map("file_path")
  url                String
  fileName           String            @map("file_name")
  mimeType           String?           @map("mime_type")
  sizeBytes          Int?              @map("size_bytes")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_attachments")
}

model TaskSubtask {
  parentTaskId String   @map("parent_task_id") @db.Uuid
  childTaskId  String   @map("child_task_id") @db.Uuid
  displayOrder Int?     @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  parentTask Task @relation("TaskParentToSubtask", fields: [parentTaskId], references: [id], onDelete: Cascade)
  childTask  Task @relation("TaskChildToSubtask", fields: [childTaskId], references: [id], onDelete: Cascade)

  @@id([parentTaskId, childTaskId])
  @@index([childTaskId])
  @@map("task_subtasks")
}

model Testimonial {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientName      String    @map("client_name")
  clientTitle     String?   @map("client_title")
  clientCompany   String?   @map("client_company")
  clientAvatarUrl String?   @map("client_avatar_url")
  content         String
  rating          Int?      @default(5) // DB checked: >= 1 AND <= 5
  projectId       String?   @map("project_id") @db.Uuid
  isFeatured      Boolean?  @default(false) @map("is_featured")
  displayOrder    Int?      @default(0) @map("display_order")
  isVisible       Boolean?  @default(true) @map("is_visible")
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz

  project Project? @relation(fields: [projectId], references: [id])

  @@map("testimonials")
}

model WeeklyReport {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String        @map("project_id") @db.Uuid
  title     String
  content   Json?
  status    ReportStatus? @default(DRAFT)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime      @default(now()) @map("updated_at") @db.Timestamptz

  project     Project                  @relation(fields: [projectId], references: [id])
  attachments WeeklyReportAttachment[]
  comments    WeeklyReportComment[]

  @@index([projectId, createdAt])
  @@map("weekly_reports")
}

model WeeklyReportAttachment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId  String   @map("report_id") @db.Uuid
  filePath  String   @map("file_path")
  url       String
  fileName  String   @map("file_name")
  mimeType  String?  @map("mime_type")
  sizeBytes Int?     @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  report WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
  @@map("weekly_report_attachments")
}

model WeeklyReportComment {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId       String            @map("report_id") @db.Uuid
  parentId       String?           @map("parent_id") @db.Uuid
  authorType     ActivityActorType @map("author_type")
  authorUserId   String?           @map("author_user_id")
  authorClientId String?           @map("author_client_id") @db.Uuid
  body           Json
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz

  report  WeeklyReport          @relation(fields: [reportId], references: [id], onDelete: Cascade)
  parent  WeeklyReportComment?  @relation("WeeklyReportCommentToReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies WeeklyReportComment[] @relation("WeeklyReportCommentToReplies")

  @@index([reportId, createdAt])
  @@index([parentId])
  @@map("weekly_report_comments")
}

model ActivityLog {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId     String             @map("project_id") @db.Uuid
  entityType    ActivityEntityType @map("entity_type")
  entityId      String             @map("entity_id") @db.Uuid
  action        ActivityAction
  actorType     ActivityActorType  @map("actor_type")
  actorUserId   String?            @map("actor_user_id")
  actorClientId String?            @map("actor_client_id") @db.Uuid
  diff          Json?              @map("diff")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([entityType, entityId])
  @@map("activity_logs")
}
