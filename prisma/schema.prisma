generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum BlogPostCategory {
  TECH              @map("tech")
  PERSONAL_GROWTH   @map("personal-growth")
  ENGINEERING_NOTES @map("engineering-notes")
  TUTORIALS         @map("tutorials")
  DEV_JOURNEY       @map("dev-journey")
}

enum ContactSubmissionStatus {
  NEW      @map("new")
  READ     @map("read")
  REPLIED  @map("replied")
  ARCHIVED @map("archived")
}

enum ResourceType {
  FILE @map("file")
  LINK @map("link")
}

enum ProjectCategory {
  WEB_APP      @map("web-app")
  SAAS         @map("saas")
  MOBILE       @map("mobile")
  LANDING_PAGE @map("landing-page")
  E_COMMERCE   @map("e-commerce")
  OTHER        @map("other")
}

enum ProjectStatus {
  COMPLETED         @map("completed")
  IN_PROGRESS       @map("in-progress")
  UNDER_DEVELOPMENT @map("under-development")
}

enum ProjectType {
  PORTFOLIO @map("portfolio")
  CLIENT    @map("client")
}

enum InvoiceStatus {
  UNPAID    @map("unpaid")
  PAID      @map("paid")
  PENDING   @map("pending")
  CANCELLED @map("cancelled")
}

enum SkillCategory {
  FRONTEND           @map("frontend")
  BACKEND            @map("backend")
  DATABASE           @map("database")
  DEVOPS             @map("devops")
  TOOLS              @map("tools")
  CURRENTLY_LEARNING @map("currently-learning")
}

enum TaskStatus {
  BACKLOG     @map("backlog")
  TODO        @map("todo")
  IN_PROGRESS @map("in-progress")
  REVIEW      @map("review")
  DONE        @map("done")
}

enum TaskPriority {
  LOW    @map("low")
  MEDIUM @map("medium")
  HIGH   @map("high")
  URGENT @map("urgent")
}

enum TaskType {
  FEATURE  @map("feature")
  BUG      @map("bug")
  CHORE    @map("chore")
  REFACTOR @map("refactor")
  MEETING  @map("meeting")
  OTHER    @map("other")
}

enum ReportStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
}

// -----------------------------------------------------------------------------
// Models
// -----------------------------------------------------------------------------

model BlogPost {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title              String
  slug               String           @unique
  excerpt            String
  content            Json
  featuredImageUrl   String?          @map("featured_image_url")
  category           BlogPostCategory
  tags               String[]         @default([])
  readingTimeMinutes Int?             @default(5) @map("reading_time_minutes")
  isPublished        Boolean?         @default(false) @map("is_published")
  publishedAt        DateTime?        @map("published_at") @db.Timestamptz
  createdAt          DateTime?        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime?        @default(now()) @map("updated_at") @db.Timestamptz

  @@map("blog_posts")
}

model Client {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  email       String?
  company     String?
  avatarUrl   String?  @map("avatar_url")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz
  accessToken String?  @map("access_token")

  projects Project[]

  @@map("clients")
}

model ContactSubmission {
  id          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  email       String
  projectType String?                  @map("project_type")
  budgetRange String?                  @map("budget_range")
  deadline    String?
  message     String
  status      ContactSubmissionStatus? @default(NEW)
  createdAt   DateTime?                @default(now()) @map("created_at") @db.Timestamptz

  @@map("contact_submissions")
}

model ProjectFile {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId    String        @map("project_id") @db.Uuid
  name         String
  url          String
  resourceType ResourceType? @default(FILE) @map("resource_type")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id])

  @@map("project_files")
}

model Project {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title             String
  slug              String          @unique
  shortDescription  String          @map("short_description")
  fullDescription   Json?           @map("full_description")
  thumbnailUrl      String?         @map("thumbnail_url")
  featuredImageUrl  String?         @map("featured_image_url")
  category          ProjectCategory
  techStack         String[]        @default([]) @map("tech_stack")
  status            ProjectStatus   @default(COMPLETED)
  liveUrl           String?         @map("live_url")
  repoUrl           String?         @map("repo_url")
  problem           String?
  solution          String?
  researchNotes     String?         @map("research_notes")
  designProcess     String?         @map("design_process")
  architectureNotes String?         @map("architecture_notes")
  challenges        String?
  learnings         String?
  isFeatured        Boolean?        @default(false) @map("is_featured")
  displayOrder      Int?            @default(0) @map("display_order")
  year              Int?
  createdAt         DateTime?       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime?       @default(now()) @map("updated_at") @db.Timestamptz
  galleryImages     String[]        @default([]) @map("gallery_images")
  clientId          String?         @map("client_id") @db.Uuid
  type              ProjectType?    @default(PORTFOLIO)
  accessToken       String?         @map("access_token")
  startDate         DateTime?       @map("start_date") @db.Timestamptz
  dueDate           DateTime?       @map("due_date") @db.Timestamptz
  budget            Decimal?        @db.Decimal
  invoiceStatus     InvoiceStatus?  @map("invoice_status")

  client        Client?        @relation(fields: [clientId], references: [id])
  files         ProjectFile[]
  tasks         Task[]
  testimonials  Testimonial[]
  weeklyReports WeeklyReport[]

  @@map("projects")
}

model Service {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String
  slug             String    @unique
  shortDescription String    @map("short_description")
  fullDescription  String?   @map("full_description")
  iconName         String?   @map("icon_name")
  displayOrder     Int?      @default(0) @map("display_order")
  isActive         Boolean?  @default(true) @map("is_active")
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime? @default(now()) @map("updated_at") @db.Timestamptz

  @@map("services")
}

model SiteSetting {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String    @unique
  value     String?
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamptz

  @@map("site_settings")
}

model Skill {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  category         SkillCategory
  iconName         String?       @map("icon_name")
  proficiencyLevel Int?          @default(80) @map("proficiency_level") // DB checked: >= 0 AND <= 100
  displayOrder     Int?          @default(0) @map("display_order")
  isVisible        Boolean?      @default(true) @map("is_visible")
  createdAt        DateTime?     @default(now()) @map("created_at") @db.Timestamptz

  @@map("skills")
}

model Task {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId       String        @map("project_id") @db.Uuid
  title           String
  description     String?
  status          TaskStatus?   @default(TODO)
  priority        TaskPriority? @default(MEDIUM)
  dueDate         DateTime?     @map("due_date") @db.Timestamptz
  assigneeId      String?       @map("assignee_id") @db.Uuid // Mentions auth.users(id) - omit relation for Supabase auth
  displayOrder    Int?          @default(0) @map("display_order")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @default(now()) @map("updated_at") @db.Timestamptz
  type            TaskType?     @default(FEATURE)
  isClientVisible Boolean?      @default(false) @map("is_client_visible")

  project Project @relation(fields: [projectId], references: [id])

  @@map("tasks")
}

model Testimonial {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientName      String    @map("client_name")
  clientTitle     String?   @map("client_title")
  clientCompany   String?   @map("client_company")
  clientAvatarUrl String?   @map("client_avatar_url")
  content         String
  rating          Int?      @default(5) // DB checked: >= 1 AND <= 5
  projectId       String?   @map("project_id") @db.Uuid
  isFeatured      Boolean?  @default(false) @map("is_featured")
  displayOrder    Int?      @default(0) @map("display_order")
  isVisible       Boolean?  @default(true) @map("is_visible")
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz

  project Project? @relation(fields: [projectId], references: [id])

  @@map("testimonials")
}

model WeeklyReport {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String        @map("project_id") @db.Uuid
  title     String
  content   Json?
  status    ReportStatus? @default(DRAFT)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime      @default(now()) @map("updated_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id])

  @@map("weekly_reports")
}
